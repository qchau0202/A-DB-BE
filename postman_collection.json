{
  "info": {
    "name": "DevConnect API",
    "description": "Postman collection for DevConnect backend API - Auth, Profiles, Posts, Follows",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/sign-up",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Sign In",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/sign-in",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/session"
          }
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/auth/sign-out"
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/profile/me"
          }
        },
        {
          "name": "Get Profile by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/profile/{{profileId}}"
          }
        },
        {
          "name": "Get Profile by User ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/profile/by-user/{{userId}}"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"display_name\": \"John Doe\",\n  \"bio\": \"Software Developer\",\n  \"username\": \"johndoe\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Follow",
      "item": [
        {
          "name": "Follow User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/profile/follow/{{targetUserId}}"
          }
        },
        {
          "name": "Unfollow User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/profile/unfollow/{{targetUserId}}"
          }
        },
        {
          "name": "Get Followers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/profile/{{profileId}}/followers"
          }
        },
        {
          "name": "Get Following",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/profile/{{profileId}}/following"
          }
        },
        {
          "name": "Check if Following",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/profile/me/is-following/{{targetUserId}}"
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/posts",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My First Post\",\n  \"content_blocks\": [\n    {\n      \"type\": \"text\",\n      \"data\": \"This is the content of my post!\"\n    },\n    {\n      \"type\": \"image\",\n      \"data\": \"https://example.com/image.jpg\"\n    }\n  ],\n  \"image_urls\": [\"https://example.com/image.jpg\"],\n  \"tags\": [\"tech\", \"intro\"],\n  \"visibility\": \"public\",\n  \"is_announcement\": false\n}"
            }
          }
        },
        {
          "name": "Get Post by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        },
        {
          "name": "Update Post",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/posts/{{postId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Title\",\n  \"content_blocks\": [\n    {\n      \"type\": \"text\",\n      \"data\": \"Updated content!\"\n    }\n  ],\n  \"tags\": [\"updated\", \"post\"]\n}"
            }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/posts/{{postId}}"
          }
        },
        {
          "name": "Get Latest Feed",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/feed/latest?limit=20&skip=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "feed", "latest"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "skip", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Announcements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/feed/announcements?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "feed", "announcements"],
              "query": [
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Posts by Author",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/author/{{authorId}}?limit=20&skip=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "author", "{{authorId}}"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "skip", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Posts by Tags",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/feed/tags?tags=tech,db&limit=20&skip=0",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "feed", "tags"],
              "query": [
                { "key": "tags", "value": "tech,db" },
                { "key": "limit", "value": "20" },
                { "key": "skip", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Search Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/posts/search?q=developer&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "posts", "search"],
              "query": [
                { "key": "q", "value": "developer" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Add Reaction",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/posts/{{postId}}/react",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reaction\": \"like\"\n}"
            }
          }
        }
      ]
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "profileId",
      "value": "",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "postId",
      "value": "",
      "type": "string"
    },
    {
      "key": "authorId",
      "value": "",
      "type": "string"
    }
  ]
}
